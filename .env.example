# --- core ---
# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://cortex:cortex@localhost:5432/cortex?sslmode=disable
# Interface the API server binds to. Loopback by default — there is no auth
# yet, and every chat request spends money. Set 0.0.0.0 only on purpose.
HOST=127.0.0.1
# HTTP port for the API server
PORT=8080
# Postgres used by integration tests; those tests skip when this is unset.
# MUST be a throwaway database: the tests TRUNCATE it. docker compose creates
# it on first start, and `make migrate-test` applies the schema.
TEST_DATABASE_URL=postgres://cortex:cortex@localhost:5432/cortex_test?sslmode=disable
# Allowed origin for the frontend (CORS)
FRONTEND_ORIGIN=http://localhost:3000
# The origin this API is reached at from outside, e.g.
# https://cortex-api.onrender.com. Leave EMPTY for local development.
#
# Set it on a hosted deployment and two things follow from it: the hostname is
# added to the Host-header allowlist, and the Google OAuth redirect URIs are
# built from it. Without it a deployment bound to 0.0.0.0 refuses every request
# with 421 — including its own health check — and sign-in redirects the browser
# to localhost. One variable because both need the same fact, and they must not
# be able to disagree.
API_PUBLIC_URL=

# --- LLM ---
# OPTIONAL. The server's own key, which pays for embeddings: the indexing crawl
# and the knowledge-base query embedder, both of which read the server's shared
# index. Chat completions do NOT run on it — each signed-in user adds their own
# key in Settings and their runs spend that one, so a user without a key gets a
# failed run rather than a bill charged here.
#
# Leave it empty and indexing is disabled with a line in the startup log: the
# demo workspace keeps its live Jira, Notion and Gmail tools (reading a source
# costs no tokens) and loses only search_knowledge_base. `make eval` does need
# it — a server-initiated run has no user whose key it could spend.
OPENAI_API_KEY=
# Optional: override for testing against a fake/alternate endpoint
OPENAI_BASE_URL=
# Main agent model
LLM_MODEL=gpt-4o
# Cheap model for summarization / grading
LLM_UTILITY_MODEL=gpt-4o-mini
# Embedding model for the knowledge base. Changing it after indexing makes the
# stored vectors incomparable — reindex from scratch if you do.
EMBEDDING_MODEL=text-embedding-3-small

# --- agent ---
# Maximum tool-calling iterations in one investigation. This is the ceiling on
# what a single question can cost, so raise it deliberately.
MAX_ITERATIONS=12
# Agent runs executed concurrently by the River workers in the server process.
AGENT_RUN_WORKERS=4
# Estimated-token ceiling for one investigation's transcript. When an
# investigation approaches it, the oldest tool observations are replaced by
# utility-model summaries (recorded as context_compaction run events).
CONTEXT_TOKEN_BUDGET=80000

# --- indexing (RAG) ---
# Documents read per source per `make index` run. A crawl is otherwise unbounded
# in both time and OpenAI spend — an unfamiliar mailbox has no natural size — so
# raise this deliberately. Re-indexing is cheap: documents whose content has not
# changed are skipped before anything is embedded.
INDEX_MAX_DOCUMENTS=400
# Indexing jobs run concurrently. One is usually right: the crawls are bounded by
# the Jira/Notion/Gmail rate limits, not by local CPU.
INDEX_WORKERS=1

# --- DEMO WORKSPACE (all three sources below are OPTIONAL) ---
#
# These configure the *demo* workspace only: a read-only showcase users can opt
# into from the Connections page. Every user connects their own Jira, Notion and
# Gmail through the app, and those connections are what their questions search.
#
# Leave all of them blank and Cortex runs as bring-your-own-sources: there is no
# demo workspace, demo mode is unreachable, and a new account connects a source
# before it can ask anything. Configure a source and it must be configured
# WHOLE — a half-filled source fails at startup naming the missing field.
#
# Think before enabling a demo on a public deployment: anyone who can sign in
# can query it. Pin it with GMAIL_QUERY_SCOPE/JIRA_PROJECTS below, and restrict
# sign-in with AUTH_ALLOWED_EMAILS.

# --- Jira (Atlassian Cloud) — optional, all three or none ---
# The site must have the Jira product installed — a Confluence-only site 404s
# every Jira endpoint.
# e.g. https://yoursite.atlassian.net (no trailing slash)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Required WHEN demo Jira is configured above, and meaningless without it.
# Comma-separated project keys the agent and the indexing crawl are pinned to.
# If sign-in is left open, any Google account can drive the agent against this
# Jira site, so an authenticated stranger must be structurally unable to reach
# projects outside the demo set:
#   JIRA_PROJECTS=ATLAS,BEACON,COMET
# A demo Jira with this empty refuses to start.
JIRA_PROJECTS=

# --- Notion (internal integration) ---
# Optional (demo Notion), and the whole source: this one variable is all it
# takes, so there is no half-configured state to get wrong.
# Create an internal integration at notion.so/my-integrations, then SHARE the
# parent page with it — an integration can only see pages shared with it.
NOTION_TOKEN=
# Optional. The page the seeder creates fixture pages under. Leave it empty and
# the seeder uses the single page shared with the integration; set it only when
# more than one page is shared and the choice is ambiguous.
NOTION_PARENT_PAGE_ID=

# --- Gmail (OAuth desktop credential) ---
# Optional (demo Gmail). Path to the downloaded OAuth *Desktop* client JSON.
# Scopes needed on the consent screen: gmail.readonly (the agent tools),
# gmail.insert and gmail.labels (the fixture seeder).
GMAIL_CREDENTIALS_JSON=./gmail-credentials.json
# Where `make gmail-auth` caches the refresh token. Gitignored; mode 0600.
# Demo Gmail counts as configured when this file exists OR GMAIL_TOKEN_JSON is
# set below.
GMAIL_TOKEN_PATH=./.gmail-token.json
# Optional. The same JSON the token file holds, for hosts with an ephemeral
# filesystem (Render, Fly, containers generally): `make gmail-auth` is
# interactive and cannot run there, so the file it writes disappears on every
# deploy. Paste the contents of .gmail-token.json here once instead. The file
# wins when both are present, so a local re-auth still takes effect.
GMAIL_TOKEN_JSON=
# Required WHEN demo Gmail is configured above, and meaningless without it.
# ANDed into every demo Gmail search the agent makes and into the indexing
# crawl. It scopes the demo mailbox only — a user's own connected Gmail is
# theirs to search in full.
#
# The demo mailbox is somebody's real one, so this is the structural half of
# the protection: whoever can sign in must be unable to search outside this
# scope, whatever the allowlist below is set to. Demo Gmail with this empty
# refuses to start, in both the server and the Gmail client.
#   GMAIL_QUERY_SCOPE=label:vantage-labs
GMAIL_QUERY_SCOPE=

# --- auth (Google sign-in; per-user Gmail connect) ---
# REQUIRED. OAuth *Web application* client for user sign-in — a second client in
# the same Google Cloud project as the Gmail Desktop one (a Desktop client cannot
# take a server redirect URI). Authorized redirect URIs (both):
#   http://localhost:8080/api/auth/google/callback
#   http://localhost:8080/api/connections/gmail/callback
# The second one is the per-user "Connect Gmail" flow, which also needs
# the gmail.readonly scope on the consent screen. gmail.readonly is a Google
# RESTRICTED scope: in Testing mode it works for listed test users, but a
# public production app needs Google's app verification (potentially a CASA
# security assessment) first — do not promise public Gmail connect before then.
# Add gmail.send to the same consent screen if you want the write actions below:
# it is requested only when a user explicitly enables writes for their own Gmail
# connection, never as part of connecting, and it is restricted at the same tier
# as gmail.readonly — so the same verification story applies.
# While the consent screen is in Testing, only listed test users can sign in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated emails allowed to sign in. EMPTY means any Google account.
#
# STRONGLY RECOMMENDED on any public deployment, and close to mandatory if a
# demo workspace is configured above: without it, everyone who signs in can
# query the demo Jira, Notion and Gmail — which are somebody's real accounts.
# The server logs a warning at startup when open sign-in and a demo workspace
# are configured together. While the consent screen is in Testing, Google itself
# limits sign-in to listed test users, which is a stopgap, not this setting.
AUTH_ALLOWED_EMAILS=
# REQUIRED. Static bearer token for non-browser callers (`make index`, scripts):
# requests carrying it act as DEV_USER_EMAIL with admin rights. Generate:
#   openssl rand -hex 24
AUTH_API_TOKEN=
# Optional. Comma-separated emails whose sessions may call admin endpoints
# (POST /api/admin/index). Defaults to DEV_USER_EMAIL.
ADMIN_EMAILS=
# Optional. The operator identity: the user the bearer token acts as, and the
# default admin email. Defaults to dev@cortex.local.
DEV_USER_EMAIL=

# --- bring-your-own-key ---
# REQUIRED. AES-256 key encrypting users' stored LLM API keys at rest.
# Exactly 64 hex characters (32 bytes). Generate:
#   openssl rand -hex 32
# Rotating it invalidates every stored key — users re-add them.
LLM_KEY_ENCRYPTION_SECRET=
# Runs one user may create per hour; beyond it POST /api/chat returns 429. The
# LLM spend is the user's own key, but every run also consumes the server's
# Jira/Notion/Gmail quotas.
RUNS_PER_USER_PER_HOUR=30
# Minimum interval between user-triggered Sources refreshes (Go duration).
INDEX_REFRESH_COOLDOWN=15m

# ---------------------------------------------------------------------------
# Write actions (human approval required)
# ---------------------------------------------------------------------------
# Cortex can send email and create or change Jira issues and Notion pages, but
# never on its own: the agent PROPOSES a write, the run pauses, and a person
# approves, edits, or rejects it before anything happens. There is no
# auto-approve setting, by design — everything the agent reads is text somebody
# else wrote, and a write is the one thing it does that reaches other people.
#
# Writes are also off per source until a user turns them on for their own
# connection, and are never available on the demo workspace.

# How long a proposed write waits for a decision before it expires and can no
# longer be carried out (Go duration). A day covers a working day plus a night;
# an approval is a judgement about a moment, and the moment does not last.
ACTION_TTL=24h
# Writes one user may have carried out per hour. Much lower than the run limit
# because it bounds something different: this is a backstop against a runaway
# loop, not a throughput target.
#
# Read it precisely: the ceiling is checked when a write is PROPOSED, and counts
# writes already carried out or in flight in the past hour. It is not a hard cap
# on sends per hour — proposals waiting for a decision count zero, so a queue of
# them approved together can exceed this within the hour. What it bounds is a
# loop that proposes without limit, which is the runaway it exists to stop; every
# send still needs a person to approve it.
WRITES_PER_USER_PER_HOUR=20
# Concurrency on the write execution queue. Two: a write is one HTTP request,
# and the queue also carries the hourly expiry sweep, which must not sit behind
# a slow send.
WRITE_ACTION_WORKERS=2
# Comma-separated domains a proposed email may be addressed to. Empty (the
# default) allows any — a policy nobody configured should not silently disable
# the feature. Enforced when the write is proposed, so an out-of-policy
# recipient is something the agent can tell you about rather than a failure
# after you have already approved the message.
#   GMAIL_SEND_ALLOWED_DOMAINS=example.com,partner.example
GMAIL_SEND_ALLOWED_DOMAINS=
