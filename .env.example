# --- core ---
# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://cortex:cortex@localhost:5432/cortex?sslmode=disable
# HTTP port for the API server
PORT=8080
# Allowed origin for the frontend (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# --- LLM ---
OPENAI_API_KEY=
# Optional: override for testing against a fake/alternate endpoint
OPENAI_BASE_URL=
# Main agent model
LLM_MODEL=gpt-4o
# Cheap model for summarization / grading
LLM_UTILITY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Jira (Atlassian Cloud) ---
# e.g. https://yoursite.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Notion (internal integration) ---
NOTION_TOKEN=

# --- Gmail (OAuth desktop credential) ---
# Path to the downloaded OAuth client credentials JSON
GMAIL_CREDENTIALS_JSON=./gmail-credentials.json
